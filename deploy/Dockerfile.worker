# Standalone BullMQ worker image. Runs src/worker.ts via tsx (no build step — the worker
# executes TypeScript source directly, same as `npm run worker` locally).
FROM node:22-slim

WORKDIR /app

ENV NODE_OPTIONS="--disable-warning=DEP0169"

# Install deps first for layer caching. tsx is a devDependency, so we need the full install
# (not --omit=dev).
COPY package*.json .npmrc* ./
RUN npm ci --legacy-peer-deps

COPY . .

# One always-on process draining every queue. Env (DATABASE_URL, REDIS_URL, NEXTAUTH_SECRET, …)
# comes from docker-compose. Restart policy lives in compose, not here.
CMD ["npm", "run", "worker"]
